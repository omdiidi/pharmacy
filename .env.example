# OpenRouter API key — single key for all models (Claude, Grok, Mercury, etc.)
OPENROUTER_API_KEY=

# Optional metadata for OpenRouter analytics dashboard
OPENROUTER_APP_NAME=PharmaDash
OPENROUTER_APP_URL=http://localhost:3000

# Supabase project URL (public; safe in NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public; RLS-safe; safe in NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER ONLY — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string — used by backup script (pg_dump)
SUPABASE_DB_URL=

# Comma-separated allowlist of emails permitted to sign in (Phase 1: Kaleem only)
ALLOWED_USER_EMAILS=

# Public site URL — needed for Supabase magic-link redirectTo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GPG symmetric passphrase for encrypting pg_dump output before upload to B2
BACKUP_PASSPHRASE=

# Backblaze B2 — write-only API key scoped to backup bucket only
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=pharm1-backups
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Sentry DSN for error reporting (no-op when empty)
SENTRY_DSN=

# Daily Claude spend cap in USD — chat route returns 429 above this
MAX_DAILY_CLAUDE_SPEND_USD=50

# Demo-only: gates the password sign-in shortcut on Render. Single-user demo flag.
DEV_LOGIN_ENABLED=
# Demo-only: password for the dev-login shortcut. Pair with ALLOWED_USER_EMAILS.
DEV_PASSWORD=
# Demo-only (public): exposes the Quick dev sign-in form on /sign-in.
NEXT_PUBLIC_DEV_LOGIN_ENABLED=

# Comma-separated env var names whose values are redacted in Sentry events.
REDACT_ENV=

# --- Wave 2: Amazon SP-API ---
# Login With Amazon (LWA) credentials from Seller Central → Develop Apps.
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=

# Long-lived refresh token captured during self-authorization or OAuth.
# When unset, lib/sp-api falls back to fixture data in vendor/sp-api-fixtures/.
SP_API_REFRESH_TOKEN=

# Region: na | eu | fe | sandbox_na (default na).
SP_API_REGION=na

# US marketplace by default. Kaleem currently sells US only.
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER

# Amazon merchant token (the seller_id in URL paths).
SP_API_SELLER_ID=

# HMAC secret used to verify inbound /api/sp-api/webhook POSTs.
# Generate locally with: openssl rand -hex 32
SP_API_WEBHOOK_SECRET=

# --- Wave 2: Twilio SMS (Account Health red-alert) ---
# When unset, sendSms() logs to console instead of dialing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
KALEEM_SMS_NUMBER=

# --- Wave 3: Voyage AI embeddings (Phase 1.5 fold-in) ---
# When unset, lib/voyage/embed.ts returns null and pg_trgm fallback covers retrieval.
VOYAGE_API_KEY=

# --- Wave 3: openFDA (free; key optional — raises rate limit from 1k/day to 120k/day) ---
FDA_API_KEY=

# --- Wave 3: Keepa ---
# When unset, lib/keepa/index.ts returns the fixture client (vendor/keepa-fixtures).
KEEPA_API_KEY=

# --- Wave 3: EzriRx EDI ---
# When all three are unset, lib/edi/index.ts returns the fixture client (vendor/edi-fixtures).
EZRIRX_SFTP_HOST=
EZRIRX_SFTP_USER=
EZRIRX_SFTP_KEY=

# Node environment
NODE_ENV=development
