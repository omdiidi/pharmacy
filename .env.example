# Anthropic Claude API key — used by chat route + worker for all LLM calls
ANTHROPIC_API_KEY=

# Supabase project URL (public; safe in NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public; RLS-safe; safe in NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER ONLY — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres connection string — used by backup script (pg_dump)
SUPABASE_DB_URL=

# Comma-separated allowlist of emails permitted to sign in (Phase 1: Kaleem only)
ALLOWED_USER_EMAILS=

# Public site URL — needed for Supabase magic-link redirectTo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GPG symmetric passphrase for encrypting pg_dump output before upload to B2
BACKUP_PASSPHRASE=

# Backblaze B2 — write-only API key scoped to backup bucket only
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=pharm1-backups
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Sentry DSN for error reporting (no-op when empty)
SENTRY_DSN=

# Daily Claude spend cap in USD — chat route returns 429 above this
MAX_DAILY_CLAUDE_SPEND_USD=50

# Node environment
NODE_ENV=development
